NODE_ENV=development
PORT=3000

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_spreadsheet_id
GOOGLE_SHEETS_SHEET_NAME=Demo Requests
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/dreams-sheets-service-account.json
# Alternatif untuk hosting (pilih salah satu cara, bukan keduanya):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=nama@project-id.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
PUBLIC_RATE_LIMIT_MAX=10
LINK_RATE_LIMIT_MAX=60

# WhatsApp bisnis: kode negara tanpa "+", contoh 6281234567890
WHATSAPP_NUMBER=6281234567890

# Jumlah proxy/load balancer di depan aplikasi.
# 0 = tanpa proxy (lokal). Biasanya 1 jika di Render, Railway, Nginx, Cloudflare, dll.
# Jika salah, semua pengunjung berbagi satu kuota rate limit.
TRUST_PROXY=0