
# Environment aplikasi
# development = pengembangan lokal
# production = lingkungan hosting
# test = pengujian otomatis
NODE_ENV=development

# Port backend API
PORT=3000


# =========================================
# GOOGLE SHEETS CONFIGURATION
# =========================================

# ID spreadsheet Google Sheets.
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_spreadsheet_id

# Nama worksheet/tab di dalam spreadsheet.
GOOGLE_SHEETS_SHEET_NAME=Demo Requests

# Lokasi file JSON Google Service Account.
# Path relatif dihitung dari direktori backend.
# Kosongkan jika menggunakan autentikasi email dan private key.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/dreams-sheets-service-account.json

# Alternatif untuk hosting.
# Pilih salah satu metode autentikasi, bukan keduanya.
# Jika menggunakan file JSON, biarkan email dan private key kosong.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# CORS
# Daftar origin frontend yang diizinkan mengakses backend.
# Pisahkan beberapa origin menggunakan koma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# =========================================
# RATE LIMITING
# =========================================

# Durasi jendela pembatasan request dalam milidetik.
# 900000 = 15 menit.
RATE_LIMIT_WINDOW_MS=900000

# Maksimal request endpoint publik per IP dalam satu jendela.
PUBLIC_RATE_LIMIT_MAX=10

# Maksimal request pembuatan link WhatsApp per IP dalam satu jendela.
LINK_RATE_LIMIT_MAX=60


# =========================================
# WHATSAPP
# =========================================

# Nomor WhatsApp bisnis.
# Gunakan kode negara tanpa tanda "+".
# Contoh: 6281234567890
WHATSAPP_NUMBER=6281234567890


# =========================================
# TRUST PROXY
# =========================================

# Jumlah proxy/load balancer di depan aplikasi.
# 0 = tanpa proxy (lokal).
# Biasanya 1 jika di Render, Railway, Nginx, Cloudflare, dll.
# Jika salah, identifikasi IP pengunjung dapat keliru
# sehingga semua pengunjung berpotensi berbagi satu kuota rate limit.
TRUST_PROXY=0
