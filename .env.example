# =========================================
# APPLICATION
# =========================================

# development | production | test
NODE_ENV=development

# Express API port
PORT=3000


# =========================================
# GOOGLE SHEETS
# =========================================

GOOGLE_SHEETS_SPREADSHEET_ID=your_google_spreadsheet_id
GOOGLE_SHEETS_SHEET_NAME=Demo Requests

# Path relatif dihitung dari root project.
# Kosongkan jika menggunakan email dan private key.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/dreams-sheets-service-account.json

# Alternatif autentikasi untuk hosting.
# Gunakan salah satu metode autentikasi saja.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=


# =========================================
# CORS
# =========================================

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# =========================================
# RATE LIMITING
# =========================================

RATE_LIMIT_WINDOW_MS=900000
PUBLIC_RATE_LIMIT_MAX=10
LINK_RATE_LIMIT_MAX=60


# =========================================
# WHATSAPP
# =========================================

# Gunakan kode negara tanpa tanda "+".
WHATSAPP_NUMBER=6281234567890


# =========================================
# TRUST PROXY
# =========================================

# 0 = tanpa proxy.
# 1 = satu reverse proxy.
TRUST_PROXY=0


# =========================================
# FRONTEND
# =========================================

# Development menggunakan proxy Vite ke Express.
# Production menggunakan endpoint relatif pada domain yang sama.
VITE_API_BASE_URL=/api

VITE_CONTACT_EMAIL=halo@contoh-domain.com

# Domain final tanpa trailing slash.
VITE_SITE_URL=

# Analytics. Kosong = tidak dimuat.
VITE_GTM_ID=
VITE_GA_ID=
VITE_CLARITY_ID=
