# Salin berkas ini menjadi ".env" lalu isi nilainya.
# Jangan commit berkas .env ke git.
# Semua variabel berawalan VITE_ ikut masuk ke bundle dan bisa dilihat
# pengunjung, jadi jangan isi dengan kunci rahasia atau token.

# Alamat dasar API, termasuk /api, tanpa garis miring di akhir
VITE_API_BASE_URL=https://api.contoh-domain.com/api

# Email kontak
VITE_CONTACT_EMAIL=halo@contoh-domain.com

# Catatan: nomor WhatsApp TIDAK diisi di sini. Nomornya disimpan di .env
# backend (WHATSAPP_NUMBER).

# Alamat situs final, tanpa garis miring di akhir (contoh https://dreams.contoh.com).
# Dipakai untuk canonical, sitemap, dan gambar preview saat dibagikan di WhatsApp.
VITE_SITE_URL=

# ID analytics. Kosong = skrip tidak dimuat.
# Jika VITE_GTM_ID diisi, pasang GA4 dari dalam GTM.
# Microsoft Clarity tetap bisa dipasang secara terpisah.
VITE_GTM_ID=
VITE_GA_ID=
VITE_CLARITY_ID=